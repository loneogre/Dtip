# -----------------------------------------------------------------------------
# EDIT 1 — append to __init__(), after the self.re_error = re.compile(...) block
# -----------------------------------------------------------------------------

        # Expect-patterns for prompt-aware reads. The old code stopped a read on
        # ANY trailing [#>], which meant an unsolicited prompt already sitting in
        # the buffer (e.g. the one a console-timeout logout emits) was mistaken
        # for the reply to the command just sent.
        self.re_enable_prompt = re.compile(r'(?m)^([\w.\-]+)(?:\([\w\-]+\))?#\s*$')
        self.re_user_prompt = re.compile(r'(?m)^([\w.\-]+)>\s*$')
        self.re_password = re.compile(r'(?i)password:\s*$')
        self.re_username = re.compile(r'(?i)username:\s*$')
        self.re_denied = re.compile(r'(?i)(access denied|invalid password|bad password)')
        # The factory wizard's prompts also end in 'password:', so they must be
        # tested BEFORE re_password wherever both are candidates.
        self.re_wizard = re.compile(r'(?i)(enter\s{1,3}password:|repeat\s+password:)\s*$')


# -----------------------------------------------------------------------------
# EDIT 2 — new helper methods
# -----------------------------------------------------------------------------

    def _drain(self):
        """Discard anything left in the receive buffer from a previous command."""
        try:
            if self.serial_port and self.serial_port.in_waiting:
                self.serial_port.reset_input_buffer()
        except Exception as e:
            logging.debug(f"Buffer drain failed: {e}")

    def _write_line(self, text):
        """Raw single-CR write. '\\r\\n' is two line terminators to the ASA and
        makes it emit two prompts for every one command."""
        self.serial_port.write((text + '\r').encode('utf-8'))
        self.serial_port.flush()

    def _read_for(self, patterns, timeout=10):
        """
        Read until one of (name, compiled_pattern) matches, in list order.
        Returns (name, buffer) or (None, buffer) on timeout.

        The buffer starts empty on every call, so a match can only come from
        output produced after this call began — that is what stops a stale
        prompt from satisfying the read.
        """
        buf = ""
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.serial_port.in_waiting:
                buf += self.serial_port.read(
                    self.serial_port.in_waiting).decode('utf-8', errors='ignore')
                if self.verbose:
                    print(buf[-200:], end='', flush=True)
                for name, pattern in patterns:
                    if pattern.search(buf):
                        return name, buf
            time.sleep(0.05)
        return None, buf

    def _restore_terminal(self):
        """
        Re-apply pager/width. A console-timeout logout resets terminal settings,
        so 'terminal pager 0' is undone and the next 'show running-config ...'
        stalls on <--- More ---> until the reader times out.
        """
        for cmd in ('terminal pager 0', 'terminal width 200'):
            self._drain()
            self._write_line(cmd)
            self._read_for([('enable', self.re_enable_prompt)], timeout=5)

    def ensure_enable(self):
        """
        Guarantee the session is at a '#' prompt, re-authenticating if a console
        timeout has dropped it back to '>'. Safe to call repeatedly — call it at
        the top of each long stage so a mid-run logout is recovered rather than
        silently swallowing every following command.
        """
        if not self.serial_port or not self.serial_port.is_open:
            return False
        return self._serial_enter_enable_mode()



    def _drain(self):
        """Discard anything left in the receive buffer from a previous command."""
        try:
            if self.serial_port and self.serial_port.in_waiting:
                stale = self.serial_port.read(self.serial_port.in_waiting)
                if self.console_debug and stale:
                    print(f"[DRAINED] {stale!r}")
        except Exception as e:
            logging.debug(f"Buffer drain failed: {e}")

    def _write_line(self, text):
        """Raw single-CR write. '\\r\\n' is two line terminators to the ASA and
        makes it emit two prompts for every one command."""
        if self.console_debug:
            print(f"[SEND] {text!r}")
        self.serial_port.write((text + '\r').encode('utf-8'))
        self.serial_port.flush()

    def _normalize(self, text):
        """
        Make a raw console stream safe to pattern-match: drop ANSI sequences,
        fold both \\r\\n and bare \\r to \\n, and remove NULs/backspaces. Without
        this a single stray byte hides an otherwise obvious prompt.
        """
        text = self.re_ansi.sub('', text)
        text = text.replace('\r\n', '\n').replace('\r', '\n')
        return text.replace('\x00', '').replace('\x08', '')

    def _last_line(self, text):
        """The last non-blank line of the normalised stream, stripped."""
        for line in reversed(self._normalize(text).split('\n')):
            if line.strip():
                return line.strip()
        return ''

    def _classify(self, text):
        """
        Identify what the device is currently asking for, from the last line.
        Returns one of: wizard, username, password, enable, user, None.
        """
        line = self._last_line(text)
        if not line:
            return None, line
        low = line.lower()

        # The factory wizard's prompts also end in 'password:', so test first.
        if self.re_wizard_tail.search(low):
            return 'wizard', line
        if low.endswith('username:') or low.endswith('login:'):
            return 'username', line
        if low.endswith('password:'):
            return 'password', line
        if line.endswith('#'):
            return 'enable', line
        if line.endswith('>'):
            return 'user', line
        return None, line

    def _expect(self, states, timeout=10):
        """
        Read until the device reaches one of `states`. Returns (state, buffer).

        The buffer starts empty each call, so a stale prompt left over from a
        console-timeout logout cannot satisfy the read.
        """
        buf = ""
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.serial_port.in_waiting:
                buf += self.serial_port.read(
                    self.serial_port.in_waiting).decode('utf-8', errors='ignore')
                state, _line = self._classify(buf)
                if state in states:
                    # Let any straggling bytes land so the next read starts clean.
                    time.sleep(0.15)
                    if self.serial_port.in_waiting:
                        buf += self.serial_port.read(
                            self.serial_port.in_waiting).decode('utf-8', errors='ignore')
                        state, _line = self._classify(buf)
                    if self.console_debug:
                        print(f"[RECV:{state}] {buf!r}")
                    return state, buf
            time.sleep(0.05)

        if self.console_debug:
            print(f"[RECV:timeout] {buf!r}")
        return None, buf

    ALL_STATES = ('wizard', 'username', 'password', 'enable', 'user')

    def _wake(self, attempts=3, timeout=3):
        """
        Poke the console until it shows us something. A device that has just
        logged out, or one whose first character got eaten, needs more than the
        single CR v1 sent before giving up.
        """
        buf = ""
        for attempt in range(attempts):
            self._drain()
            self._write_line('')
            state, buf = self._expect(self.ALL_STATES, timeout=timeout)
            if state:
                return state, buf
            logging.debug(f"No prompt on wake attempt {attempt + 1}")
        return None, buf

    def _enable_secret_candidates(self):
        """
        Every credential worth trying at a 'Password:' prompt, in order, with
        duplicates removed. The empty string is last and matters: an ASA with
        NO enable password set still prompts, and accepts a blank line.
        """
        candidates = [
            self.secret,
            os.getenv('ASA_SECRET'),
            os.getenv('ASA_KNOWN_SECRET', 'Cisco123'),
            '',
        ]
        seen = set()
        ordered = []
        for candidate in candidates:
            if candidate is None or candidate in seen:
                continue
            seen.add(candidate)
            ordered.append(candidate)
        return ordered

    def _restore_terminal(self):
        """
        Re-apply pager/width. A console-timeout logout resets terminal settings,
        so 'terminal pager 0' is undone and the next 'show running-config ...'
        stalls on <--- More ---> until the reader times out.
        """
        for cmd in ('terminal pager 0', 'terminal width 200'):
            self._drain()
            self._write_line(cmd)
            self._expect(('enable',), timeout=5)

    def ensure_enable(self):
        """
        Guarantee the session is at a '#' prompt, re-authenticating if a console
        timeout has dropped it back to '>'. Safe to call repeatedly — call it at
        the top of each long stage.
        """
        if not self.serial_port or not self.serial_port.is_open:
            return False
        return self._serial_enter_enable_mode()



    def _serial_enter_enable_mode(self):
        """
        Bring the session to a '#' prompt from wherever it currently is.

        Handles: already at '#', at a user prompt such as 'wkgfw>' or 'senfw>'
        after a console-timeout logout, sitting at a bare 'Password:' prompt,
        and the factory wizard. Tries every known credential including a blank
        one, because an ASA with no enable password set still prompts for it.
        """
        state, buf = self._wake()

        if state is None:
            logging.debug(f"No prompt from console. Last bytes: {buf.strip()[-120:]!r}")
            if self.console_debug:
                warn(f"No recognisable prompt. Raw: {buf!r}")
            return False

        if state == 'enable':
            logging.info("Already in enable mode.")
            return True

        if state == 'username':
            error("Console is behind AAA authentication (Username: prompt). "
                  "This script handles the enable password only — log in "
                  "manually or remove 'aaa authentication serial console'.")
            return False

        if state == 'wizard':
            success("Detected active Factory Password Wizard. Synchronizing...")
            secret = self.secret or os.getenv('ASA_SECRET') \
                or os.getenv('ASA_KNOWN_SECRET', 'Cisco123')
            if self._handle_factory_password_setup(secret):
                self.secret = secret
                return True
            return False

        if state == 'user':
            hostname = self._last_line(buf).rstrip('>').strip()
            if hostname.lower().startswith('ciscoasa'):
                success("Factory-fresh device detected (ciscoasa> prompt).")
            else:
                logging.info(f"At user EXEC prompt ({hostname}>) — entering enable mode.")

        candidates = self._enable_secret_candidates()

        for index, secret in enumerate(candidates):
            # Re-issue 'enable' for each attempt: a rejected password drops
            # straight back to '>' and the prompt has to be asked for again.
            if state != 'password':
                self._drain()
                self._write_line('enable')
                state, buf = self._expect(
                    ('wizard', 'password', 'enable', 'user'), timeout=10)

                if state == 'enable':
                    # No enable password configured at all.
                    success("Enable mode entered (no password required).")
                    return True

                if state == 'wizard':
                    success("Factory password wizard triggered by 'enable'.")
                    if self._handle_factory_password_setup(secret or 'Cisco123'):
                        self.secret = secret or 'Cisco123'
                        return True
                    return False

                if state is None:
                    logging.debug("No response to 'enable'.")
                    if self.console_debug:
                        warn(f"No response to 'enable'. Raw: {buf!r}")
                    return False

                if state == 'user':
                    # Echoed straight back to '>' without prompting — the CR was
                    # probably eaten. Retry once with the same credential.
                    logging.debug("'enable' returned to user prompt; retrying.")
                    continue

            # At a Password: prompt.
            label = 'blank' if secret == '' else f'credential {index + 1}'
            logging.info(f"Submitting {label} at enable password prompt.")
            self._write_line(secret)
            state, buf = self._expect(('enable', 'user', 'password'), timeout=10)

            if state == 'enable':
                self.secret = secret
                if secret == '':
                    warn("This device has no enable password set — it accepted a "
                         "blank one. Consider setting one before deployment.")
                else:
                    logging.info("Enable authentication succeeded.")
                return True

            if self.re_denied.search(self._normalize(buf)):
                logging.info(f"Enable password rejected ({label}).")
            else:
                logging.debug(f"Unexpected reply after {label}: {buf.strip()[-120:]!r}")

            if state == 'password':
                # Still prompting — the ASA re-asks up to three times before
                # dropping back to '>'. Send a CR to clear it, then re-enable.
                self._write_line('')
                self._expect(('user', 'enable'), timeout=5)
            state = 'user'

        error("Could not reach enable mode. Tried "
              f"{len(candidates)} credential(s) including a blank one. "
              "Set ASA_SECRET to the correct enable password, or run with "
              "ASA_CONSOLE_DEBUG=1 to see the raw console exchange.")
        return False
